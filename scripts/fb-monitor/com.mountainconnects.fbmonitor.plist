<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the Facebook lead monitor.

  Fires at 06:00, 12:00 and 18:00 local time. The script itself adds up to 15
  minutes of jitter, so the actual runs land somewhere inside the following
  quarter hour rather than exactly on the hour.

  Install:
    cp scripts/fb-monitor/com.mountainconnects.fbmonitor.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mountainconnects.fbmonitor.plist

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.mountainconnects.fbmonitor.plist

  Run once now, without waiting:
    launchctl start com.mountainconnects.fbmonitor

  If the Mac is asleep at the scheduled time, launchd runs the job once on
  wake rather than skipping it or firing three times.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mountainconnects.fbmonitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tylermafi/Desktop/Mountain Connect/scripts/fb-monitor/run.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/tylermafi/Desktop/Mountain Connect</string>

    <!-- launchd's default PATH omits /usr/local/bin, where node and npm live. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/tylermafi</string>
    </dict>

    <!-- launchd's own stdout/stderr, separate from the script's dated log. -->
    <key>StandardOutPath</key>
    <string>/Users/tylermafi/.mountain-connect/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tylermafi/.mountain-connect/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
